From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes <hermes@lassul.us>
Date: Wed, 28 Oct 2026 14:00:00 +0100
Subject: [PATCH 2/2] Target API level 36

The droid-nix app targets API level 36, upstream Termux:API 28.

- The PendingIntent of a notification's reply button must say whether
  it is mutable (31); it is, the reply text is added to it.
- The app may not execve its data files (29), so notification actions
  and job scheduler scripts run through droid-nix's $PREFIX/bin/login,
  which the Termux service runs with its /system/bin/sh interpreter
  and which execs its arguments in the Nix environment.
- Location: drop the check for the background location permission
  (Android 11). droid-nix's own terminal sends the request, so the app
  is in the foreground.
- Text-to-speech engines and speech recognizers are only visible to
  apps that declare them in <queries> (30).
---
 app/src/main/AndroidManifest.xml                   | 11 +++++++++++
 .../java/com/termux/api/apis/JobSchedulerAPI.java  |  5 ++++-
 .../main/java/com/termux/api/apis/LocationAPI.java | 14 +++-----------
 .../java/com/termux/api/apis/NotificationAPI.java  | 11 +++++++----
 4 files changed, 25 insertions(+), 16 deletions(-)

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index e797819..23a8442 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -55,6 +55,17 @@
     <uses-feature android:name="android.hardware.wifi" android:required="false" />
     <uses-feature android:name="android.hardware.usb.host" android:required="false" />
 
+    <!-- From targetSdkVersion 30 on, the text-to-speech engines and speech
+         recognizers are only visible to apps that declare them. -->
+    <queries>
+        <intent>
+            <action android:name="android.intent.action.TTS_SERVICE" />
+        </intent>
+        <intent>
+            <action android:name="android.speech.RecognitionService" />
+        </intent>
+    </queries>
+
 
 
     <application>
diff --git a/app/src/main/java/com/termux/api/apis/JobSchedulerAPI.java b/app/src/main/java/com/termux/api/apis/JobSchedulerAPI.java
index bfd12a2..bafed39 100644
--- a/app/src/main/java/com/termux/api/apis/JobSchedulerAPI.java
+++ b/app/src/main/java/com/termux/api/apis/JobSchedulerAPI.java
@@ -281,12 +281,15 @@ public class JobSchedulerAPI {
             String filePath = extras.getString(SCRIPT_FILE_PATH);
 
             ExecutionCommand executionCommand = new ExecutionCommand();
-            executionCommand.executableUri = new Uri.Builder().scheme(TERMUX_SERVICE.URI_SCHEME_SERVICE_EXECUTE).path(filePath).build();
+            // Run the script through droid-nix's login, see NotificationAPI.BIN_LOGIN.
+            executionCommand.executableUri = new Uri.Builder().scheme(TERMUX_SERVICE.URI_SCHEME_SERVICE_EXECUTE).path(NotificationAPI.BIN_LOGIN).build();
+            executionCommand.arguments = new String[]{filePath};
             executionCommand.runner = ExecutionCommand.Runner.APP_SHELL.getName();
 
             // Create execution intent with the action TERMUX_SERVICE#ACTION_SERVICE_EXECUTE to be sent to the TERMUX_SERVICE
             Intent executionIntent = new Intent(TERMUX_SERVICE.ACTION_SERVICE_EXECUTE, executionCommand.executableUri);
             executionIntent.setClassName(TermuxConstants.TERMUX_PACKAGE_NAME, TermuxConstants.TERMUX_APP.TERMUX_SERVICE_NAME);
+            executionIntent.putExtra(TERMUX_SERVICE.EXTRA_ARGUMENTS, executionCommand.arguments);
             executionIntent.putExtra(TERMUX_SERVICE.EXTRA_RUNNER, executionCommand.runner);
             executionIntent.putExtra(TERMUX_SERVICE.EXTRA_BACKGROUND, true); // Also pass in case user using termux-app version < 0.119.0
 
