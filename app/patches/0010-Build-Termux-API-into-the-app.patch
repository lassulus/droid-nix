From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes <hermes@lassul.us>
Date: Wed, 28 Oct 2026 14:00:00 +0100
Subject: [PATCH] Build Termux:API into the app

droid-nix carries Termux:API (termux/termux-api with droid-nix's
patches) in its own APK instead of a separate app with the same
sharedUserId. droid-nix copies it to termux-api/; include its app/ as
the library module ":termux-api" and depend on it, so its manifest
(receiver, services, activities, permissions) merges into the app's.

TERMUX_API_PACKAGE_NAME is the app's package name: the API's
preferences, intent extras and its section in the settings belong to
the app itself.
---
 app/build.gradle                                              | 1 +
 settings.gradle                                               | 4 ++++
 .../main/java/com/termux/shared/termux/TermuxConstants.java   | 2 +-
 3 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/app/build.gradle b/app/build.gradle
index ee16c0b..7315c0a 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -36,6 +36,7 @@ android {
 
         implementation project(":terminal-view")
         implementation project(":termux-shared")
+        implementation project(":termux-api")
     }
 
     defaultConfig {
diff --git a/settings.gradle b/settings.gradle
index b8045c2..25ab0f2 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -1 +1,5 @@
 include ':app', ':termux-shared', ':terminal-emulator', ':terminal-view'
+
+// Termux:API, built into the app; droid-nix copies termux-api to termux-api/.
+include ':termux-api'
+project(':termux-api').projectDir = file('termux-api/app')
diff --git a/termux-shared/src/main/java/com/termux/shared/termux/TermuxConstants.java b/termux-shared/src/main/java/com/termux/shared/termux/TermuxConstants.java
index 1d79a60..c660012 100644
--- a/termux-shared/src/main/java/com/termux/shared/termux/TermuxConstants.java
+++ b/termux-shared/src/main/java/com/termux/shared/termux/TermuxConstants.java
@@ -365,7 +365,7 @@ public final class TermuxConstants {
     /** Termux:API app name */
     public static final String TERMUX_API_APP_NAME = "Termux:API"; // Default: "Termux:API"
     /** Termux:API app package name */
-    public static final String TERMUX_API_PACKAGE_NAME = TERMUX_PACKAGE_NAME + ".api"; // Default: "com.termux.api"
+    public static final String TERMUX_API_PACKAGE_NAME = TERMUX_PACKAGE_NAME; // The app carries the API. Default: "com.termux.api"
     /** Termux:API GitHub repo name */
     public static final String TERMUX_API_GITHUB_REPO_NAME = "termux-api"; // Default: "termux-api"
     /** Termux:API GitHub repo url */
