From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hermes <hermes@lassul.us>
Date: Sun, 25 Oct 2026 16:09:59 +0100
Subject: [PATCH 1/5] Rebrand as droid-nix (us.lassul.droidnix)

Install as a separate app next to Termux and Nix-on-Droid: package id
us.lassul.droidnix (also used as sharedUserId and as prefix for
authorities, permissions and intent actions), label "droid-nix",
version 0.5.0 (5). The Java classes keep their com.termux namespace.

TermuxConstants derived several class names (BuildConfig, TermuxActivity,
TermuxService, RunCommandService, ...) from TERMUX_PACKAGE_NAME, which
only works while the package id equals the Java namespace. Derive them
from a new TERMUX_APP_CLASS_PACKAGE_NAME instead.

Issue links point to github.com/lassulus/droid-nix.

Based on nix-on-droid-app commit 54ab7d3f ("Rebrand as Nix /
Nix-on-Droid") by Alexander Sosedkin.
---
 app/build.gradle                              | 14 ++++++-----
 app/src/main/res/values/strings.xml           |  4 ++--
 app/src/main/res/xml/shortcuts.xml            |  8 +++----
 .../termux/shared/termux/TermuxConstants.java | 24 ++++++++++---------
 termux-shared/src/main/res/values/strings.xml |  6 ++---
 5 files changed, 30 insertions(+), 26 deletions(-)

diff --git a/app/build.gradle b/app/build.gradle
index 33c88d1d..a9fe1cd5 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -41,18 +41,20 @@ android {
     }
 
     defaultConfig {
+        // Java classes stay in the "com.termux" namespace, only the package id changes.
+        applicationId "us.lassul.droidnix"
         minSdkVersion project.properties.minSdkVersion.toInteger()
         targetSdkVersion project.properties.targetSdkVersion.toInteger()
-        versionCode 118
-        versionName "0.118.0"
+        versionCode 7
+        versionName "0.7.0"
 
         if (appVersionName) versionName = appVersionName
         validateVersionName(versionName)
 
         buildConfigField "String", "TERMUX_PACKAGE_VARIANT", "\"" + project.ext.packageVariant + "\"" // Used by TermuxApplication class
 
-        manifestPlaceholders.TERMUX_PACKAGE_NAME = "com.termux"
-        manifestPlaceholders.TERMUX_APP_NAME = "Termux"
+        manifestPlaceholders.TERMUX_PACKAGE_NAME = "us.lassul.droidnix"
+        manifestPlaceholders.TERMUX_APP_NAME = "droid-nix"
         manifestPlaceholders.TERMUX_API_APP_NAME = "Termux:API"
         manifestPlaceholders.TERMUX_BOOT_APP_NAME = "Termux:Boot"
         manifestPlaceholders.TERMUX_FLOAT_APP_NAME = "Termux:Float"
@@ -132,10 +134,10 @@ android {
         variant.outputs.all { output ->
             if (variant.buildType.name == "debug") {
                 def abi = output.getFilter(com.android.build.OutputFile.ABI)
-                outputFileName = new File("termux-app_" + (apkVersionTag ? apkVersionTag : project.ext.packageVariant + "-" + "debug") + "_" + (abi ? abi : "universal") + ".apk")
+                outputFileName = new File("droid-nix_" + (apkVersionTag ? apkVersionTag : project.ext.packageVariant + "-" + "debug") + "_" + (abi ? abi : "universal") + ".apk")
             } else if (variant.buildType.name == "release") {
                 def abi = output.getFilter(com.android.build.OutputFile.ABI)
-                outputFileName = new File("termux-app_" + (apkVersionTag ? apkVersionTag : project.ext.packageVariant + "-" + "release") + "_" + (abi ? abi : "universal") + ".apk")
+                outputFileName = new File("droid-nix_" + (apkVersionTag ? apkVersionTag : project.ext.packageVariant + "-" + "release") + "_" + (abi ? abi : "universal") + ".apk")
             }
         }
     }
