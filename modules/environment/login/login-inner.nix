{ config, lib, initialPackageInfo, writeText }:

let
  # The bootstrap's static nix and busybox; its /bin/sh is busybox, so the
  # initial build below is POSIX sh.
  inherit (initialPackageInfo) busybox nix;

  nixCmd = "${nix}/bin/nix --extra-experimental-features 'flakes nix-command'";
  flakeDir = "${config.user.home}/.config/droid-nix";
  userShell =
    if config.user.shell.type or "not-found" == "derivation" then
      if config.user.shell ? passthru.shellPath then
        "${config.user.shell}${config.user.shell.passthru.shellPath}"
      else builtins.abort "Derivation without shell path found at `user.shell`. Use the path to the exact binary."
    else config.user.shell;
in

writeText "login-inner" ''
  # This file is generated by droid-nix. DO NOT EDIT.

  set -eo pipefail

  ${lib.optionalString (config.environment.motd != null) ''
    if [ "$#" -eq 0 ]; then  # if script is called from within droid-nix app
      echo "${lib.removeSuffix "\n" config.environment.motd}"
    fi
  ''}

  ${lib.optionalString config.build.initialBuild ''
    if [ -e /etc/UNINTIALISED ]; then
      export HOME="${config.user.home}"
      export USER="${config.user.userName}"

      # To prevent gc warnings of nix, see https://github.com/NixOS/nix/issues/3237
      export GC_NPROCS=1

      echo "Setting default user profile..."
      ${nix}/bin/nix-env --switch-profile /nix/var/nix/profiles/per-user/$USER/profile

      [ "$#" -gt 0 ] || echo "Sourcing Nix environment..."
      . ${nix}/etc/profile.d/nix.sh

      export NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

      echo "Installing flake from default template..."
      ${nixCmd} flake new ${flakeDir} --template ${config.build.flake.droid-nix}

      ${lib.optionalString config.build.flake.inputOverrides ''
        echo "Overriding input urls in the flake..."
        ${busybox}/bin/sed -i 's|"github:lassulus/droid-nix"|"${lib.escape [ "\\" "&" "|" ] config.build.flake.droid-nix}"|' \
          "${flakeDir}/flake.nix"
      ''}

      echo "Installing first droid-nix generation..."
      ${nixCmd} run ${config.build.flake.droid-nix} -- switch --flake ${flakeDir}

      echo
      echo "Congratulations! Now you have Nix installed with some default packages like bashInteractive, \
    coreutils, cacert and, most importantly, droid-nix itself to manage local configuration. Edit the flake"
      echo "  ~/.config/droid-nix/"
      echo "and run"
      echo "  droid-nix switch"
      echo
    fi

    # The switch made /bin/sh and this script those of its generation.
    exec /bin/sh /usr/lib/login-inner "$@"
  ''}

  . "${config.user.home}/.nix-profile/etc/profile.d/droid-nix-session-init.sh"

  ${config.environment.loginHook}

  usershell="${userShell}"
  if [ "$#" -gt 0 ]; then  # if script is not called from within droid-nix app
    exec /usr/bin/env "$@"
  elif [ -d "$usershell" ]; then
    echo "Cannot execute shell '${userShell}', it is a directory."
    echo "You should point 'user.shell' to the exact binary."
    echo "Falling back to bash."
    exec -l bash
  elif [ -x "$usershell" ]; then
    exec -a "-''${usershell##*/}" "$usershell"
  else
    echo "Cannot execute shell '${userShell}', falling back to bash"
    exec -l bash
  fi
''
